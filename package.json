{
	"name": "baton-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun x --bun vite dev",
		"build": "bun x --bun vite build",
		"check": "bun x --bun svelte-kit sync && bun x --bun svelte-check --tsconfig ./tsconfig.json",
		"format": "bun x --bun biome format --write .",
		"check-format": "bun x --bun biome format .",
		"lint": "bun x --bun biome lint ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.61.0",
		"@sveltejs/adapter-node": "^5.3.0",
		"@sveltejs/kit": "^2.48.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "latest",
		"bits-ui": "^2.20.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.7.3",
		"vite": "^6.2.0"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0"
	}
}
