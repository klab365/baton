{
	"schemaVersion": 3,
	"agents": [
		{
			"id": "writer",
			"systemPrompt": "Implement the requested changes directly in the isolated project worktree. First inspect the relevant files, then make focused edits with built-in tools and verify them. Never modify .git, .baton, hidden files, build output, or dependency directories. Report changed paths and verification.",
			"model": {
				"provider": "332e1c86-969f-4639-aab7-398fc088effd",
				"model": "gpt-6-luna",
				"maxOutputTokens": 2048
			},
			"rules": [],
			"toolIds": [
				"builtin.read.v1",
				"builtin.write.v1",
				"builtin.list.v1",
				"builtin.search.v1",
				"builtin.patch.v1",
				"builtin.delete.v1"
			],
			"skillIds": []
		},
		{
			"id": "reviewer",
			"systemPrompt": "Independently inspect the writer's changed project files using built-in tools. Review correctness and tests. After tool calls return only JSON with outcome (approved or revise_build) and output (brief decision). Never approve without inspecting the changes.",
			"model": {
				"provider": "332e1c86-969f-4639-aab7-398fc088effd",
				"model": "gpt-6-luna",
				"maxOutputTokens": 2048
			},
			"rules": [],
			"toolIds": ["builtin.read.v1", "builtin.list.v1", "builtin.search.v1"],
			"skillIds": []
		}
	],
	"pipelines": [
		{
			"id": "draft",
			"name": "Draft and review",
			"steps": [
				{
					"id": "write",
					"name": "Write",
					"agentId": "writer",
					"human": false,
					"transitions": []
				},
				{
					"id": "review",
					"name": "Review",
					"agentId": "reviewer",
					"human": false,
					"transitions": [
						{
							"outcome": "approved",
							"to": "human-decision",
							"maxTraversals": 1
						},
						{
							"outcome": "revise_build",
							"to": "write",
							"maxTraversals": 2
						},
						{
							"outcome": "revise_plan",
							"to": "write",
							"maxTraversals": 2
						},
						{
							"outcome": "blocked",
							"to": "human-decision",
							"maxTraversals": 1
						}
					]
				},
				{
					"id": "human-decision",
					"name": "Human approval",
					"agentId": "",
					"human": true,
					"transitions": [
						{
							"outcome": "approved",
							"to": null,
							"maxTraversals": 1
						},
						{
							"outcome": "rejected",
							"to": "write",
							"maxTraversals": 2
						},
						{
							"outcome": "responded",
							"to": "write",
							"maxTraversals": 2
						}
					]
				}
			]
		}
	],
	"tools": [
		{
			"id": "builtin.read.v1",
			"name": "Read artifacts"
		},
		{
			"id": "builtin.write.v1",
			"name": "Create artifact"
		},
		{
			"id": "builtin.list.v1",
			"name": "List artifacts"
		},
		{
			"id": "builtin.search.v1",
			"name": "Search project files"
		},
		{
			"id": "builtin.patch.v1",
			"name": "Patch project files"
		},
		{
			"id": "builtin.delete.v1",
			"name": "Delete project files"
		}
	],
	"skills": []
}
